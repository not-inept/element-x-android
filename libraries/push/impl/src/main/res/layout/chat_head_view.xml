<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="64dp"
    android:layout_height="64dp">

    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:background="@drawable/chat_head_circle_background"
        android:elevation="4dp">

        <ImageView
            android:id="@+id/chat_head_avatar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:scaleType="fitCenter"
            android:clipToOutline="true"
            android:contentDescription="@string/chat_head_avatar_description" />

    </FrameLayout>

    <!-- Unread badge - higher elevation to appear on top -->
    <TextView
        android:id="@+id/chat_head_badge"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="2dp"
        android:elevation="8dp"
        android:background="@drawable/chat_head_badge_background"
        android:gravity="center"
        android:textColor="@android:color/white"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone" />

</FrameLayout>
